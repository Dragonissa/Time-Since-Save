<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TimeSinceSave</AssemblyName>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- Path to copy the final DLL to -->
  <PropertyGroup>
    <RimWorldModsAssemblies>E:\SteamLibrary\steamapps\common\RimWorld\Mods\Time Since Save\Assemblies\</RimWorldModsAssemblies>
  </PropertyGroup>

  <!-- Copy the built DLL to the RimWorld Mods Assemblies folder after build -->
  <Target Name="CopyToRimWorldAssemblies" AfterTargets="Build">
